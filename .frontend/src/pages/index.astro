---
import ColaboradorForm from "../components/organisms/ColaboradorForm.vue";
import TotalsDashboard from "../components/organisms/TotalsDashboard.vue";
import ColaboradorList from "../components/organisms/ColaboradorList.vue";
import ThemeToggle from "../components/atoms/ThemeToggle.vue";
import "../styles/global.css";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>Nómina Pro - Calculadora Salarial</title>
		<meta
			name="description"
			content="Herramienta de gestión y cálculo de nómina en Colombia. Incluye normatividad vigente, horas extras, prestaciones y proyecciones 2023-2026."
		/>

		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-ZP56GLR91Y"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-ZP56GLR91Y');
		</script>
		
		<!-- Theme Logic (inline to prevent FOUC) -->
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();
			document.documentElement.setAttribute('data-theme', theme);
		</script>

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
	</head>
	<body>
		<main class="app-container">
			<header class="app-header">
				<div class="header-content">
					<div class="header-main">
						<div class="header-text">
							<h1 class="text-h4 gradText">Nómina Pro</h1>
							<p class="text-subtitle">Gestión salarial inteligente para Colombia</p>
						</div>
						<ThemeToggle client:load />
					</div>
				</div>
			</header>

			<section class="app-content">
				<div class="sidebar">
					<ColaboradorForm client:load />
				</div>
				<div class="main-panel">
					<TotalsDashboard client:load />
					<ColaboradorList client:load />
				</div>
			</section>
		</main>
	</body>
</html>

<style>
	.app-container {
		min-height: 100vh;
		background: var(--bg-main);
	}

	.app-header {
		background: var(--bg-surface);
		border-bottom: 1px solid var(--border-color);
		padding: 2rem 0;
		margin-bottom: 2rem;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
	}

	.header-content {
		max-width: 1600px;
		margin: 0 auto;
		padding: 0 3rem;
	}

	.header-main {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.gradText {
		background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		font-weight: 800;
	}

	.app-content {
		max-width: 1600px;
		margin: 0 auto;
		padding: 0 3rem 4rem;
		display: grid;
		grid-template-columns: 480px 1fr;
		gap: 3.5rem;
		align-items: start;
	}

	.sidebar {
		position: sticky;
		top: 2rem;
	}

	.main-panel {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	@media (max-width: 1100px) {
		.app-content {
			grid-template-columns: 1fr;
		}
		.sidebar {
			position: static;
		}
	}
</style>
